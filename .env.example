# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your actual '.env' file to version control.
# ==============================================================================

# Django Security Settings
# Generate a secret key or use a secure random string for production
DJANGO_SECRET_KEY=django-insecure-replace-this-with-a-secure-random-key-for-local-dev
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Textbee SMS Gateway Configuration
# Obtain your API Key and Device ID from the Textbee Dashboard (https://textbee.dev)
TEXTBEE_API_KEY=your_textbee_api_key_here
TEXTBEE_DEVICE_ID=your_textbee_device_id_here
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1
